{
  "name": "taladelivery-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TalaDelivery NestJS microservices platform (Laravel migration - reference repo: tala-api)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "nest build",
    "build:all": "nest build api-gateway identity-service merchant-service catalog-service order-service dispatch-service payment-service notification-service realtime-service",
    "build:api-gateway": "nest build api-gateway",
    "build:identity": "nest build identity-service",
    "build:merchant": "nest build merchant-service",
    "build:catalog": "nest build catalog-service",
    "build:order": "nest build order-service",
    "build:dispatch": "nest build dispatch-service",
    "build:payment": "nest build payment-service",
    "build:notification": "nest build notification-service",
    "build:realtime": "nest build realtime-service",
    "typecheck": "npm run typecheck:api-gateway && npm run typecheck:identity && npm run typecheck:merchant && npm run typecheck:catalog && npm run typecheck:order && npm run typecheck:dispatch && npm run typecheck:payment && npm run typecheck:notification && npm run typecheck:realtime",
    "typecheck:api-gateway": "tsc -p apps/api-gateway/tsconfig.app.json --noEmit",
    "typecheck:identity": "tsc -p apps/identity-service/tsconfig.app.json --noEmit",
    "typecheck:merchant": "tsc -p apps/merchant-service/tsconfig.app.json --noEmit",
    "typecheck:catalog": "tsc -p apps/catalog-service/tsconfig.app.json --noEmit",
    "typecheck:order": "tsc -p apps/order-service/tsconfig.app.json --noEmit",
    "typecheck:dispatch": "tsc -p apps/dispatch-service/tsconfig.app.json --noEmit",
    "typecheck:payment": "tsc -p apps/payment-service/tsconfig.app.json --noEmit",
    "typecheck:notification": "tsc -p apps/notification-service/tsconfig.app.json --noEmit",
    "typecheck:realtime": "tsc -p apps/realtime-service/tsconfig.app.json --noEmit",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:all": "jest --passWithNoTests --config jest.config.js",
    "test:e2e": "jest --config ./jest-e2e.config.js --runInBand",
    "start:dev": "nest start --watch",
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "start:dev:identity": "nest start identity-service --watch",
    "start:dev:merchant": "nest start merchant-service --watch",
    "start:dev:catalog": "nest start catalog-service --watch",
    "start:dev:order": "nest start order-service --watch",
    "start:dev:dispatch": "nest start dispatch-service --watch",
    "start:dev:payment": "nest start payment-service --watch",
    "start:dev:notification": "nest start notification-service --watch",
    "start:dev:realtime": "nest start realtime-service --watch",
    "start:prod:api-gateway": "node dist/apps/api-gateway/main.js",
    "start:prod:identity": "node dist/apps/identity-service/main.js",
    "start:prod:merchant": "node dist/apps/merchant-service/main.js",
    "start:prod:catalog": "node dist/apps/catalog-service/main.js",
    "start:prod:order": "node dist/apps/order-service/main.js",
    "start:prod:dispatch": "node dist/apps/dispatch-service/main.js",
    "start:prod:payment": "node dist/apps/payment-service/main.js",
    "start:prod:notification": "node dist/apps/notification-service/main.js",
    "start:prod:realtime": "node dist/apps/realtime-service/main.js",
    "migration:run": "npm run migration:run:identity && npm run migration:run:merchant && npm run migration:run:catalog && npm run migration:run:order && npm run migration:run:dispatch && npm run migration:run:payment && npm run migration:run:notification",
    "migration:run:identity": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d apps/identity-service/src/config/data-source.ts",
    "migration:run:merchant": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d apps/merchant-service/src/config/data-source.ts",
    "migration:run:catalog": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d apps/catalog-service/src/config/data-source.ts",
    "migration:run:order": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d apps/order-service/src/config/data-source.ts",
    "migration:run:dispatch": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d apps/dispatch-service/src/config/data-source.ts",
    "migration:run:payment": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d apps/payment-service/src/config/data-source.ts",
    "migration:run:notification": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d apps/notification-service/src/config/data-source.ts",
    "migration:revert": "npm run migration:revert:identity && npm run migration:revert:merchant && npm run migration:revert:catalog && npm run migration:revert:order && npm run migration:revert:dispatch && npm run migration:revert:payment && npm run migration:revert:notification",
    "migration:revert:identity": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d apps/identity-service/src/config/data-source.ts",
    "migration:revert:merchant": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d apps/merchant-service/src/config/data-source.ts",
    "migration:revert:catalog": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d apps/catalog-service/src/config/data-source.ts",
    "migration:revert:order": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d apps/order-service/src/config/data-source.ts",
    "migration:revert:dispatch": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d apps/dispatch-service/src/config/data-source.ts",
    "migration:revert:payment": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d apps/payment-service/src/config/data-source.ts",
    "migration:revert:notification": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d apps/notification-service/src/config/data-source.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.1.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.25",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^12.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  }
}
