# ============================================================================
# TalaDelivery NestJS Backend - shared environment template
# Copy to .env and fill in secrets. Never commit .env.
# ============================================================================

# --- General ---
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=taladelivery-backend

# --- Public API key (X-App-Key). Mirrors Laravel APP_API_KEY behavior. ---
APP_API_KEY=change-me-dev-api-key
# Internal service-to-service shared secret (X-Service-Token)
INTERNAL_API_TOKEN=change-me-internal-token

# --- PostgreSQL (single server, one database per service = Phase 2) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tala
POSTGRES_PASSWORD=tala_dev_password
POSTGRES_SSL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
JWT_REFRESH_TTL=30d

# --- Service ports ---
API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
MERCHANT_SERVICE_PORT=3002
CATALOG_SERVICE_PORT=3003
ORDER_SERVICE_PORT=3004
DISPATCH_SERVICE_PORT=3005
PAYMENT_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
REALTIME_SERVICE_PORT=3008

# --- Service URLs (used by gateway + cross-service HTTP) ---
API_GATEWAY_URL=http://localhost:3000
IDENTITY_SERVICE_URL=http://localhost:3001
MERCHANT_SERVICE_URL=http://localhost:3002
CATALOG_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004
DISPATCH_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
REALTIME_SERVICE_URL=http://localhost:3008
REALTIME_WS_URL=http://localhost:3008

# --- BullMQ ---
BULLMQ_PREFIX=bull
BULLMQ_ATTEMPTS=5
BULLMQ_BACKOFF_MS=2000
OFFER_TTL_SECONDS=300

# --- FCM (Notification service; leave empty to run in stub mode) ---
FCM_SERVICE_ACCOUNT_JSON=

# --- Geocoding / routing (PlaceBoundarySearch + RoadDistance) ---
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=taladelivery-backend
GEOCODING_CACHE_DAYS=30
ROUTING_BASE_URL=
ROUTING_CONNECT_TIMEOUT_MS=2000
ROUTING_TIMEOUT_MS=5000

# --- Rate limiting (Throttler, mirrors Laravel limits) ---
THROTTLE_GUEST=60
THROTTLE_USER=120
THROTTLE_ADMIN=240